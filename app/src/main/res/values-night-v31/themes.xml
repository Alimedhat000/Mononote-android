<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      Android 12+ (dark): the mandatory system splash shows only the app
      background color with no icon, so launch feels like a plain frame
      instead of a splash screen.
    -->
    <style name="Theme.Mononote" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/background_dark</item>
        <item name="android:statusBarColor">@color/background_dark</item>
        <item name="android:navigationBarColor">@color/background_dark</item>
        <item name="android:windowSplashScreenBackground">@color/background_dark</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/ic_splash_blank</item>
        <item name="android:windowSplashScreenAnimationDuration">0</item>
    </style>
</resources>
