<?xml version="1.0" encoding="utf-8"?>
<!--
  Fully transparent splash icon. The Android 12+ system splash is mandatory
  at cold start; pointing its animated icon at this blank drawable removes
  the app icon from the splash, leaving only the matching background color
  so launch transitions straight into the UI.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <path
        android:fillColor="#00000000"
        android:pathData="M0,0h108v108h-108z" />
</vector>
