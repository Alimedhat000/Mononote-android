root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4
trim_trailing_whitespace = true
max_line_length = 120

[*.{yml,yaml}]
indent_size = 2

[*.{kt,kts}]
ij_kotlin_allow_trailing_comma = true
ij_kotlin_allow_trailing_comma_on_call_site = true
# Compose function names are PascalCase; tell ktlint's function-naming rule
# to skip @Composable functions (compose-rules enforces composable naming).
ktlint_function_naming_ignore_when_annotated_with = Composable
# Our design-token CompositionLocal is a deliberate choice; allowlist it.
compose_allowed_composition_locals = LocalMononoteColors
# Structural "single emitter" rules are disabled to match detekt config
# (screens legitimately emit many siblings).
ktlint_compose_multiple-emitters-check = disabled
ktlint_compose_content-emitter-returning-values-check = disabled
